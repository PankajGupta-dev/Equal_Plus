<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.equal_plus.ui.HomeFragment"
        android:label="Equal Plus - Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_liveAiCallFragment"
            app:destination="@id/liveAiCallFragment" />
        <action
            android:id="@+id/action_homeFragment_to_callHistoryFragment"
            app:destination="@id/callHistoryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_conversationDetailsFragment"
            app:destination="@id/conversationDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_aiPolicyFragment"
            app:destination="@id/aiPolicyFragment" />
    </fragment>

    <fragment
        android:id="@+id/liveAiCallFragment"
        android:name="com.example.equal_plus.ui.LiveAiCallFragment"
        android:label="Live AI Screening"
        tools:layout="@layout/fragment_live_ai_call">
        <action
            android:id="@+id/action_liveAiCallFragment_to_conversationDetailsFragment"
            app:destination="@id/conversationDetailsFragment" />
        <action
            android:id="@+id/action_liveAiCallFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/callHistoryFragment"
        android:name="com.example.equal_plus.ui.CallHistoryFragment"
        android:label="Call History"
        tools:layout="@layout/fragment_call_history">
        <action
            android:id="@+id/action_callHistoryFragment_to_conversationDetailsFragment"
            app:destination="@id/conversationDetailsFragment" />
        <action
            android:id="@+id/action_callHistoryFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/conversationDetailsFragment"
        android:name="com.example.equal_plus.ui.ConversationDetailsFragment"
        android:label="Conversation Details"
        tools:layout="@layout/fragment_conversation_details">
        <argument
            android:name="callId"
            android:defaultValue="default_call_id"
            app:argType="string" />
        <action
            android:id="@+id/action_conversationDetailsFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/aiPolicyFragment"
        android:name="com.example.equal_plus.ui.AiPolicyFragment"
        android:label="AI Policy Settings"
        tools:layout="@layout/fragment_ai_policy">
        <action
            android:id="@+id/action_aiPolicyFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

</navigation>
